{
  "$schema": "http://json.schemastore.org/template",
  "author": "Skyline Communications",
  "classifications": [
    "DataMiner"
  ],
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "identity": "Skyline.DataMiner.Intelligence.Script.File.Template",
  "name": "DataMiner Intelligence Script File",
  "shortName": "dataminer-intelligence-script-file",
  "defaultName": "my-script",
  "sourceName": "$name$",
  "symbols": {
    "SchemaVersion": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "1.0",
      "description": "The schema version for the intelligence file.",
      "replaces": "$SCHEMAVERSION$",
      "choices": [
        {
          "choice": "1.0",
          "description": "Schema version 1.0"
        }
      ]
    },
    "SafeScriptToolName": {
      "type": "generated",
      "generator": "regex",
      "dataType": "string",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "[^a-zA-Z0-9-]+",
            "replacement": ""
          },
          {
            "regex": "^$",
            "replacement": "my-script-tool"
          }
        ]
      }
    },
    "ScriptToolName": {
      "type": "generated",
      "generator": "casing",
      "dataType": "string",
      "replaces": "$SCRIPTTOOLNAME$",
      "parameters": {
        "source": "SafeScriptToolName",
        "toLower": true
      }
    },
    "ScriptNameInput": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "my-script",
      "description": "The actual name of the script."
    },
    "SafeScriptName": {
      "type": "generated",
      "generator": "regex",
      "dataType": "string",
      "parameters": {
        "source": "ScriptNameInput",
        "steps": [
          {
            "regex": "[^a-zA-Z0-9-]+",
            "replacement": ""
          },
          {
            "regex": "^$",
            "replacement": "my-script"
          }
        ]
      }
    },
    "ScriptName": {
      "type": "generated",
      "generator": "casing",
      "dataType": "string",
      "replaces": "$SCRIPTNAME$",
      "parameters": {
        "source": "SafeScriptName",
        "toLower": true
      }
    },
    "version": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "1.0.0",
      "description": "The version of the script."
    },
    "SafeVersion": {
      "type": "generated",
      "generator": "regex",
      "dataType": "string",
      "replaces": "$VERSION$",
      "parameters": {
        "source": "version",
        "steps": [
          {
            "regex": "[^0-9A-Za-z.+-]+",
            "replacement": ""
          },
          {
            "regex": "^(?!\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$).*$",
            "replacement": "1.0.0"
          },
          {
            "regex": "^$",
            "replacement": "1.0.0"
          }
        ]
      }
    },
    "description": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "$DESCRIPTION$",
      "description": "A brief description for the script."
    },
    "scriptName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "MyScript",
      "replaces": "$SCRIPTCLASSNAME$",
      "description": "The name of the script implementation/class."
    }
  },
  "sources": [
    {
      "exclude": [
        ".template_config/**"
      ]
    }
  ]
}