{
  "$schema": "http://json.schemastore.org/template",
  "author": "Skyline Communications",
  "classifications": [
    "DataMiner"
  ],
  "tags": {
    "language": "Python",
    "type": "project"
  },
  "identity": "Skyline.DataMiner.PythonScript.Project.Template",
  "groupIdentity": "Skyline.DataMiner.ScriptedConnector.Project.Template",
  "name": "DataMiner Connector Script",
  "description": "Creates a Python based connector script project",
  "shortName": "dataminer-connector-script",
  "sourceName": "$SCRIPTNAME$",
  "defaultName": "ConnectorScript_1",
  "preferNameDirectory": true,
  "symbols": {
    "Author": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "$AUTHOR$",
      "description": "The author."
    }
  },
  "guids": [
    "4f0bc4d6-7b21-48ee-9abc-4ce4be94b757",
    "b63ba994-1165-49c6-af48-f7bf6f0c7154"
  ],
  "sources": [
    {
      "exclude": [
        ".template_config/**"
      ],
      "rename": {
        "gitignore.txt": ".gitignore"
      }
    }
  ],
  "primaryOutputs": [
    {
      "path": "$SCRIPTNAME$.pyproj"
    }
  ]
}
